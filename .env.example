# Server-side Supabase credentials. Configure these in Vercel; do not commit values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Browser-side Supabase access used by src/lib/store.ts.
# These values are intentionally exposed to the browser, so Supabase RLS must be enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# V2 search indexing. Keep V2_SEARCH_ALLOW_MIGRATION=false until a dedicated
# test project/schema has been reviewed. The SQL migration expects 1536 dimensions.
V2_SEARCH_ENVIRONMENT=test
V2_SEARCH_ALLOW_MIGRATION=false
V2_SEARCH_SCHEMA=v2_search
# Direct Postgres connection for the offline indexer; use a test database only.
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres
# Keep true in production. Set false only for a reviewed test pooler/proxy whose
# certificate chain is not trusted by the local Node.js runtime.
SUPABASE_DB_SSL_REJECT_UNAUTHORIZED=true
V2_EMBEDDING_PROVIDER=openai-compatible
V2_EMBEDDING_MODEL=your-multilingual-embedding-model
V2_EMBEDDING_DIMENSIONS=1536
V2_EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
V2_EMBEDDING_API_KEY=your-embedding-key

# Protects access to the settings screen. Use different values in Preview and Production.
SETTINGS_ACCESS_PASSWORD=replace-with-a-strong-password
